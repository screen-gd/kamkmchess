{
  "name": "kamkmchess",
  "version": "0.1.0",
  "private": true,
  "description": "Browser chess against independently choosing AI models.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=12.14.0 <13"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node scripts/prepare-engines.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "benchmark:position-check": "node scripts/benchmark-position-check.mjs",
    "build:rules-worker": "node scripts/build-rules-worker.mjs",
    "start:rules-worker": "node build/rules-worker/worker.mjs",
    "build": "pnpm run typecheck && node scripts/prepare-engines.mjs && vite build && node scripts/build-rules-worker.mjs && node scripts/write-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@clerk/clerk-js": "6.39.1",
    "@clerk/ui": "1.40.2",
    "@lichess-org/chessground": "10.4.2",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "chessops": "0.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
